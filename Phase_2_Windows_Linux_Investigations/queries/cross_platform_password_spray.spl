
(index="win_auth_training" event_id=4625) OR (index="soc_ssh_lab" "Failed password")
| rex field=_raw "from\s+(?<src_ip>\S+)\s+port"
| rex field=_raw "user\s+(?<username>\S+)\s+from"
| rex field=_raw "for\s+(?<username1>\S+)\s+from"
| eval final_username=coalesce(username, username1)
| eval src_ip=coalesce(source_ip, src_ip)
| eval final_username1=coalesce(user, final_username)
| bin _time span=10m
| stats dc(final_username1) as uniquename by _time, src_ip, index
| eval Detection_Status=if(uniquename>=3, "Alert", "Not an alert")
| sort - uniquename
